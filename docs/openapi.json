{
  "openapi": "3.0.3",
  "info": {
    "title": "Payment Core v0.1.0",
    "version": "0.1.0",
    "description": "Реализованные маршруты авторизации, кошельков, пополнений, переводов, полного возврата, истории и сверки."
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/auth/register": {
      "post": {
        "operationId": "register",
        "security": [],
        "summary": "Создать USER",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Пользователь создан",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login",
        "security": [],
        "summary": "Войти и создать сессию",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Новая сессия",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPair"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "operationId": "refresh",
        "security": [],
        "summary": "Однократно обменять текущий refresh token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Новые токены; старый refresh больше не действует",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPair"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "security": [],
        "summary": "Отозвать сессию по действующему refresh token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Сессия отозвана, включая её access tokens"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/users/me": {
      "get": {
        "operationId": "currentUser",
        "responses": {
          "200": {
            "description": "Текущий пользователь",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/wallets": {
      "post": {
        "operationId": "createWallet",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWallet"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Создан собственный кошелёк с нулевым остатком",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Wallet"
                }
              }
            },
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "Путь созданного кошелька"
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/wallets/me": {
      "get": {
        "operationId": "ownWallets",
        "responses": {
          "200": {
            "description": "Пустой массив или единственный собственный RUB-кошелёк",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "maxItems": 1,
                  "items": {
                    "$ref": "#/components/schemas/Wallet"
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/wallets/{id}": {
      "get": {
        "operationId": "ownWallet",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Собственный кошелёк",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Wallet"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/wallets/{id}/transactions": {
      "get": {
        "operationId": "walletTransactions",
        "summary": "Проведённая история своего кошелька",
        "description": "Только владелец. REJECTED не создаёт движения. Сортировка: createdAt DESC, paymentId DESC.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Страница проведённых движений",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WalletTransactionPage"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/admin/top-ups": {
      "post": {
        "operationId": "adminTopUp",
        "summary": "Тестовое пополнение кошелька (ADMIN)",
        "description": "Перевод из выделенного технического RUB-счёта. USER получает 403 без платежа и занятия ключа.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TopUpRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Платёж полностью проведён",
            "headers": {
              "Location": {
                "description": "Адрес чтения созданного платежа",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostedPayment"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/admin/reconciliation": {
      "get": {
        "operationId": "reconciliation",
        "summary": "Сверка журнала и остатков (ADMIN)",
        "description": "Согласованный снимок PostgreSQL. Обнаруживает расхождения, но не исправляет деньги. HTTP 200 допускает consistent=false.",
        "responses": {
          "200": {
            "description": "Отчёт сверки",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReconciliationReport"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/payments/transfers": {
      "post": {
        "operationId": "transfer",
        "summary": "Перевод со своего кошелька",
        "description": "Получающий кошелёк может принадлежать другому пользователю, но его баланс не раскрывается.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransferRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Платёж полностью проведён",
            "headers": {
              "Location": {
                "description": "Адрес чтения созданного платежа",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostedPayment"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/payments/{id}": {
      "get": {
        "operationId": "getPayment",
        "summary": "Прочитать доступный платёж",
        "description": "POSTED виден инициатору и владельцам участвующих пользовательских кошельков. REJECTED виден только инициатору. Чужой объект возвращает 404.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Доступный платёж",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/payments/{id}/refund": {
      "post": {
        "operationId": "refund",
        "summary": "Полный возврат полученного перевода",
        "description": "Получатель исходного POSTED TRANSFER возвращает его полную сумму. Исходная операция остаётся POSTED. Один успешный возврат на исходный перевод.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": false,
          "description": "Тело отсутствует либо равно пустому объекту {}.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefundRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Отдельный платёж REFUND проведён",
            "headers": {
              "Location": {
                "description": "Адрес чтения возврата",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostedRefund"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "responses": {
      "Problem": {
        "description": "Единый контракт ошибки с code и traceId. Сохраняемые денежные отказы, включая INSUFFICIENT_FUNDS, PAYMENT_NOT_REFUNDABLE и PAYMENT_ALREADY_REFUNDED, содержат paymentId.",
        "headers": {
          "X-Request-Id": {
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "Credentials": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "description": "Обрезается по краям и приводится к нижнему регистру"
          },
          "password": {
            "type": "string",
            "format": "password",
            "maxLength": 72,
            "description": "At least 12 and at most 72 UTF-8 bytes"
          }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "refreshToken"
        ],
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "Непрозрачный refresh token из ответа login или refresh"
          }
        }
      },
      "User": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "email",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": [
              "USER",
              "ADMIN"
            ]
          }
        }
      },
      "TokenPair": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "accessToken",
          "refreshToken",
          "tokenType",
          "expiresIn"
        ],
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expiresIn": {
            "type": "integer",
            "format": "int64",
            "description": "Срок access token в секундах"
          }
        }
      },
      "CreateWallet": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "currency"
        ],
        "properties": {
          "currency": {
            "type": "string",
            "enum": [
              "RUB"
            ]
          }
        }
      },
      "Wallet": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "currency",
          "balanceMinor",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "currency": {
            "type": "string",
            "enum": [
              "RUB"
            ]
          },
          "balanceMinor": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "traceId"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri-reference"
          },
          "code": {
            "type": "string"
          },
          "traceId": {
            "type": "string",
            "format": "uuid",
            "description": "Для идемпотентного повтора сохраняемого отказа содержит ID исходной команды; X-Request-Id нового HTTP-запроса может отличаться."
          },
          "paymentId": {
            "type": "string",
            "format": "uuid",
            "description": "Присутствует у сохраняемого бизнес-отказа REJECTED"
          }
        }
      },
      "TopUpRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "walletId",
          "amountMinor",
          "currency"
        ],
        "properties": {
          "walletId": {
            "type": "string",
            "format": "uuid"
          },
          "amountMinor": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "Копейки; начальный лимит новой операции 100000000"
          },
          "currency": {
            "type": "string",
            "enum": [
              "RUB"
            ]
          }
        }
      },
      "TransferRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fromWalletId",
          "toWalletId",
          "amountMinor",
          "currency"
        ],
        "properties": {
          "fromWalletId": {
            "type": "string",
            "format": "uuid",
            "description": "Собственный исходный кошелёк"
          },
          "toWalletId": {
            "type": "string",
            "format": "uuid",
            "description": "Кошелёк получателя"
          },
          "amountMinor": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "Копейки; начальный лимит новой операции 100000000"
          },
          "currency": {
            "type": "string",
            "enum": [
              "RUB"
            ]
          }
        }
      },
      "PostedPayment": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "status",
          "amountMinor",
          "currency",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "TOP_UP",
              "TRANSFER"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "POSTED"
            ]
          },
          "amountMinor": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "currency": {
            "type": "string",
            "enum": [
              "RUB"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Payment": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "status",
          "amountMinor",
          "currency",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "TOP_UP",
              "TRANSFER",
              "REFUND"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "POSTED",
              "REJECTED"
            ]
          },
          "amountMinor": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "currency": {
            "type": "string",
            "enum": [
              "RUB"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "rejectionCode": {
            "type": "string",
            "nullable": true,
            "description": "Код сохраняемого отказа при REJECTED"
          },
          "originalPaymentId": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "Исходная операция для REFUND"
          }
        }
      },
      "RefundRequest": {
        "type": "object",
        "additionalProperties": false,
        "maxProperties": 0,
        "properties": {}
      },
      "PostedRefund": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "status",
          "amountMinor",
          "currency",
          "createdAt",
          "originalPaymentId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "REFUND"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "POSTED"
            ]
          },
          "amountMinor": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "currency": {
            "type": "string",
            "enum": [
              "RUB"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "originalPaymentId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "WalletTransaction": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "paymentId",
          "type",
          "createdAt",
          "currency",
          "deltaMinor"
        ],
        "properties": {
          "paymentId": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "TOP_UP",
              "TRANSFER",
              "REFUND"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "currency": {
            "type": "string",
            "enum": [
              "RUB"
            ]
          },
          "deltaMinor": {
            "type": "integer",
            "format": "int64",
            "description": "Знаковое движение кошелька в копейках"
          },
          "originalPaymentId": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "Исходный перевод для REFUND"
          }
        }
      },
      "WalletTransactionPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "page",
          "size",
          "totalElements",
          "totalPages"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WalletTransaction"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "size": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 100
          },
          "totalElements": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "totalPages": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "ReconciliationDiscrepancy": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "ACCOUNT_BALANCE_MISMATCH",
              "NEGATIVE_CUSTOMER_BALANCE",
              "LEDGER_TRANSACTION_UNBALANCED",
              "LEDGER_TRANSACTION_INCOMPLETE"
            ]
          },
          "accountId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "ledgerTransactionId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "actualMinor": {
            "type": "number",
            "nullable": true,
            "description": "Точное значение NUMERIC в копейках"
          },
          "expectedMinor": {
            "type": "number",
            "nullable": true,
            "description": "Точное значение NUMERIC в копейках"
          }
        }
      },
      "ReconciliationReport": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "consistent",
          "checkedAccounts",
          "checkedLedgerTransactions",
          "discrepancies"
        ],
        "properties": {
          "consistent": {
            "type": "boolean"
          },
          "checkedAccounts": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "checkedLedgerTransactions": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "discrepancies": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReconciliationDiscrepancy"
            }
          }
        }
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "Обязателен для денежной команды. Область: инициатор и тип команды. При повторе возвращается сохранённый статус и тело.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        }
      }
    }
  }
}
